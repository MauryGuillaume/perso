# .env.example — généré par « node noyau/env.js --exemple ». Copier en .env (jamais livré) et remplir.
# Secrètes : uniquement dans les variables de l’hébergeur en production.

# Environnement : « production » impose HTTPS, cookies sécurisés et toutes les variables obligatoires — developpement | production
APP_ENV=developpement

# Adresse publique de l’app (https://…), obligatoire en production — obligatoire en production
APP_URL=

# Nom affiché de l’app (sinon celui de app/app.js ou du réglage partagé)
APP_NOM=

# Port HTTP du serveur
PORT=3000

# Connexion PostgreSQL : postgres://utilisateur:motdepasse@hote:5432/base — OBLIGATOIRE — SECRÈTE
DATABASE_URL=

# 1 : créer la base si elle n’existe pas (serveur à toi) ; 0 chez un hébergeur qui la fournit
DB_CREER_BASE=0

# 1 : connexion chiffrée à la base (base distante : Supabase, Neon, Scaleway…)
DB_SSL=0

# 0 seulement pour un certificat auto-signé
DB_SSL_STRICT=1

# Connexions simultanées à la base
DB_POOL_MAX=10

# Clé d’admin de l’Atelier de Blocs (générée par l’Atelier, 32 caractères minimum) : l’Atelier gère l’app avec elle — obligatoire en production — SECRÈTE
ADMIN_API_KEY=

# 1 : sur une base sans admin, crée le compte « admin » / « adminadmin », à changer à la première connexion ; 0 : assistant d’installation avec INSTALL_CODE
ADMIN_DEFAUT=1

# Code de première installation ; vide = un code est tiré au hasard et affiché dans les journaux du serveur — SECRÈTE
INSTALL_CODE=

# Durée d’une session sans activité, en heures
SESSION_HEURES=12

# Longueur minimale des mots de passe
MDP_MIN=12

# 1 : chacun peut créer son compte ; 0 : comptes créés par un admin
INSCRIPTION_OUVERTE=0

# Autres origines autorisées à appeler l’API (séparées par des virgules), en plus de APP_URL : https://…, capacitor://localhost (app mobile), null (aperçu de l’Atelier), * (toutes, ignoré en production)
ORIGINES=

# Signature des jetons de connexion (front séparé, app mobile) ; vide = tirée au hasard à chaque démarrage (reconnexion après un redémarrage). Obligatoire en production si l’app utilise les jetons — SECRÈTE
JETON_SECRET=

# Durée du jeton d’accès, en minutes (renouvelé avec le jeton de renouvellement)
JETON_MINUTES=15

# Durée du jeton de renouvellement, en jours (rester connecté)
JETON_JOURS=30

# Limite de requêtes par adresse IP et par minute
REQUETES_PAR_MINUTE=300

# 1 : bandeau de publicité en bas de l’écran pour les paliers « avec pub » (Gratuit) ; 0 : aucune publicité
PUB_ACTIVE=0

# Identifiant du bloc d’annonces AdMob « bannière » Android (ca-app-pub-…/…) ; vide = bandeau maison (promotion de l’offre payante)
ADMOB_BANNIERE_ANDROID=

# Identifiant du bloc d’annonces AdMob « bannière » iOS (ca-app-pub-…/…) ; vide = bandeau maison
ADMOB_BANNIERE_IOS=

# 1 : les paliers payants peuvent s’acheter (Stripe sur le web, stores via RevenueCat sur mobile) ; 0 : écran Abonnement en « bientôt disponible »
PAIEMENT_ACTIF=0

# Clé secrète Stripe (sk_live_… ou sk_test_…) pour l’abonnement sur le web — SECRÈTE
STRIPE_SECRET=

# Secret de signature du webhook Stripe (whsec_…), adresse : APP_URL/api/offre/stripe — SECRÈTE
STRIPE_WEBHOOK_SECRET=

# Prix Stripe de chaque palier et période : premium_mois=price_…,premium_an=price_…
STRIPE_PRIX=

# Valeur de l’en-tête Authorization du webhook RevenueCat (sans « Bearer »), adresse : APP_URL/api/offre/revenuecat — SECRÈTE
REVENUECAT_WEBHOOK_CLE=

# Clé publique du SDK RevenueCat pour Android (goog_…), achats dans l’app mobile
REVENUECAT_CLE_ANDROID=

# Clé publique du SDK RevenueCat pour iOS (appl_…), achats dans l’app mobile
REVENUECAT_CLE_IOS=

# Nombre de jours sans contact avant de proposer une relance
RELANCE_JOURS=30

